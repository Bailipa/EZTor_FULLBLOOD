generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "darwin", "darwin-arm64"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                   @id @default(cuid())
  username             String                   @unique
  password             String
  isAdmin              Boolean                  @default(false)
  isBanned             Boolean                  @default(false)
  banReason            String?
  banExpiresAt         DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  ignoredWords         IgnoredWord[]
  reviewGroups         ReviewGroup[]
  securityViolations   SecurityViolation[]
  sharedVocabularies   SharedVocabulary[]       @relation("UserToSharedVocabularies")
  importedVocabularies SharedVocabularyImport[] @relation("UserToImportedVocabularies")
  preference           UserPreference?
  words                Word[]
}

model Word {
  id                 String            @id @default(cuid())
  word               String
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  correctCount       Int               @default(0)
  incorrectCount     Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  userId             String
  reviewGroupWords   ReviewGroupWord[]
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([word, userId])
}

model ReviewGroup {
  id                  String              @id @default(cuid())
  name                String
  userId              String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  defaultVocabularies DefaultVocabulary[]
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  words               ReviewGroupWord[]
  sharedVocabularies  SharedVocabulary[]  @relation("ReviewGroupToSharedVocabularies")

  @@unique([name, userId])
}

model ReviewGroupWord {
  id            String      @id @default(cuid())
  reviewGroupId String
  wordId        String
  addedAt       DateTime    @default(now())
  word          Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reviewGroup   ReviewGroup @relation(fields: [reviewGroupId], references: [id], onDelete: Cascade)

  @@unique([reviewGroupId, wordId])
}

model PublicWord {
  id                 String   @id @default(cuid())
  word               String   @unique
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  qualityScore       Int      @default(0)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([qualityScore])
}

model ApiConfig {
  id           String   @id @default("global")
  apiKey       String
  baseUrl      String   @default("https://api.openai.com/v1/chat/completions")
  model        String   @default("gpt-4o-mini")
  systemPrompt String?
  updatedAt    DateTime @updatedAt
}

model LlmApiProvider {
  id             String    @id @default(cuid())
  name           String    @unique
  apiKey         String
  baseUrl        String    @default("https://api.openai.com/v1")
  model          String    @default("gpt-4o-mini")
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  quotaRemaining Int?
  quotaUsed      Int       @default(0)
  lastUsedAt     DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, priority])
}

model SecurityViolation {
  id            String   @id @default(cuid())
  userId        String
  violationType String
  inputValue    String
  detectedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([detectedAt])
}

model IpBan {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  reason         String
  violationCount Int       @default(1)
  bannedAt       DateTime  @default(now())
  expiresAt      DateTime?
  isPermanent    Boolean   @default(false)

  @@index([ipAddress])
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  defaultShowPos        Boolean  @default(true)
  defaultShowExample    Boolean  @default(true)
  defaultShowPhonetic   Boolean  @default(true)
  dailyGoal             Int      @default(20)
  reviewReminderEnabled Boolean  @default(false)
  reviewReminderTime    String?
  theme                 String   @default("system")
  language              String   @default("zh-CN")
  danmakuEnabled        Boolean  @default(false)
  danmakuSpeed          Float    @default(1.0)
  danmakuOpacity        Float    @default(0.7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  sessionId String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([createdAt])
}

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique
  dau             Int      @default(0)
  newUsers        Int      @default(0)
  translations    Int      @default(0)
  dictations      Int      @default(0)
  errors          Int      @default(0)
  avgResponseTime Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
}

model TranslationRecord {
  id                 String   @id @default(cuid())
  userId             String?
  word               String
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  isCached           Boolean  @default(false)
  responseTime       Int?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())
  requestHash        String?

  @@index([userId])
  @@index([word])
  @@index([createdAt])
  @@index([requestHash])
}

model IgnoredWord {
  id                 String   @id @default(cuid())
  word               String
  phonetic           String?
  translation        String
  example            String?
  exampleTranslation String?
  userId             String
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([word, userId])
  @@index([userId])
  @@index([word])
}

model SharedVocabulary {
  id            String                   @id @default(cuid())
  code          String                   @unique
  name          String
  description   String?
  userId        String
  shareType     String                   @default("REVIEW_GROUP")
  reviewGroupId String
  maxUses       Int?
  usedCount     Int                      @default(0)
  expiresAt     DateTime?
  isActive      Boolean                  @default(true)
  importedCount Int                      @default(0)
  viewCount     Int                      @default(0)
  wordCount     Int
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  deletedAt     DateTime?
  reviewGroup   ReviewGroup              @relation("ReviewGroupToSharedVocabularies", fields: [reviewGroupId], references: [id], onDelete: Cascade)
  user          User                     @relation("UserToSharedVocabularies", fields: [userId], references: [id], onDelete: Cascade)
  imports       SharedVocabularyImport[] @relation("SharedVocabularyToImports")

  @@index([code])
  @@index([userId])
  @@index([reviewGroupId])
  @@index([expiresAt])
  @@index([isActive])
}

model SharedVocabularyImport {
  id            String           @id @default(cuid())
  sharedId      String
  importerId    String
  wordsImported Int
  wordsSkipped  Int              @default(0)
  targetGroupId String
  skipExisting  Boolean          @default(true)
  createdAt     DateTime         @default(now())
  importer      User             @relation("UserToImportedVocabularies", fields: [importerId], references: [id], onDelete: Cascade)
  shared        SharedVocabulary @relation("SharedVocabularyToImports", fields: [sharedId], references: [id], onDelete: Cascade)

  @@unique([sharedId, importerId])
  @@index([importerId])
  @@index([sharedId])
}

model DefaultVocabulary {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  groupId     String
  wordCount   Int
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reviewGroup ReviewGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([isActive])
}
