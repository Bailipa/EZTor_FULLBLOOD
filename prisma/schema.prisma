generator client {
  provider      = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventType String
  userId    String?
  sessionId String?
  metadata  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([eventType])
}

model ApiConfig {
  id           String   @id @default("global")
  apiKey       String
  baseUrl      String   @default("https://api.openai.com/v1/chat/completions")
  model        String   @default("gpt-4o-mini")
  systemPrompt String?
  updatedAt    DateTime
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([action])
  @@index([userId])
}

model DailyStats {
  id              String   @id @default(cuid())
  date            DateTime @unique
  dau             Int      @default(0)
  newUsers        Int      @default(0)
  translations    Int      @default(0)
  dictations      Int      @default(0)
  errors          Int      @default(0)
  avgResponseTime Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime

  @@index([date])
}

model DefaultVocabulary {
  id          String      @id @default(cuid())
  name        String
  code        String      @unique
  description String?
  groupId     String
  wordCount   Int
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  ReviewGroup ReviewGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model IgnoredWord {
  id                 String   @id @default(cuid())
  word               String
  phonetic           String?
  translation        String
  example            String?
  exampleTranslation String?
  userId             String
  createdAt          DateTime @default(now())
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([word, userId])
  @@index([word])
  @@index([userId])
}

model IpBan {
  id             String    @id @default(cuid())
  ipAddress      String    @unique
  reason         String
  violationCount Int       @default(1)
  bannedAt       DateTime  @default(now())
  expiresAt      DateTime?
  isPermanent    Boolean   @default(false)

  @@index([ipAddress])
}

model LlmApiProvider {
  id             String    @id @default(cuid())
  name           String    @unique
  apiKey         String
  baseUrl        String    @default("https://api.openai.com/v1")
  model          String    @default("gpt-4o-mini")
  priority       Int       @default(0)
  isActive       Boolean   @default(true)
  quotaRemaining Int?
  quotaUsed      Int       @default(0)
  lastUsedAt     DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime

  @@index([isActive, priority])
}

model PublicWord {
  id                 String   @id @default(cuid())
  word               String   @unique
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  qualityScore       Int      @default(0)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime

  userWords Word[]

  @@index([qualityScore])
}

model ReviewGroup {
  id                String              @id @default(cuid())
  name              String
  userId            String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  DefaultVocabulary DefaultVocabulary[]
  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ReviewGroupWord   ReviewGroupWord[]
  SharedVocabulary  SharedVocabulary[]

  @@unique([name, userId])
}

model ReviewGroupWord {
  id            String      @id @default(cuid())
  reviewGroupId String
  wordId        String
  addedAt       DateTime    @default(now())
  Word          Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  ReviewGroup   ReviewGroup @relation(fields: [reviewGroupId], references: [id], onDelete: Cascade)

  @@unique([reviewGroupId, wordId])
  @@index([reviewGroupId, addedAt(sort: Desc)])
}

model SecurityViolation {
  id            String   @id @default(cuid())
  userId        String
  violationType String
  inputValue    String
  detectedAt    DateTime @default(now())
  ipAddress     String?
  userAgent     String?
  User          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([detectedAt])
  @@index([userId])
}

model SharedVocabulary {
  id                     String                   @id @default(cuid())
  code                   String                   @unique
  name                   String
  description            String?
  userId                 String
  shareType              String                   @default("REVIEW_GROUP")
  reviewGroupId          String
  maxUses                Int?
  usedCount              Int                      @default(0)
  expiresAt              DateTime?
  isActive               Boolean                  @default(true)
  importedCount          Int                      @default(0)
  viewCount              Int                      @default(0)
  wordCount              Int
  version                Int                      @default(1)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  deletedAt              DateTime?
  ReviewGroup            ReviewGroup              @relation(fields: [reviewGroupId], references: [id], onDelete: Cascade)
  User                   User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  SharedVocabularyImport SharedVocabularyImport[]

  @@index([isActive])
  @@index([expiresAt])
  @@index([reviewGroupId])
  @@index([userId])
  @@index([code])
}

model SharedVocabularyImport {
  id               String           @id @default(cuid())
  sharedId         String
  importerId       String
  wordsImported    Int
  wordsSkipped     Int              @default(0)
  targetGroupId    String
  skipExisting     Boolean          @default(true)
  createdAt        DateTime         @default(now())
  User             User             @relation(fields: [importerId], references: [id], onDelete: Cascade)
  SharedVocabulary SharedVocabulary @relation(fields: [sharedId], references: [id], onDelete: Cascade)

  @@unique([sharedId, importerId])
  @@index([sharedId])
  @@index([importerId])
}

model TranslateOnlyUsage {
  id        String   @id @default(cuid())
  userId    String
  date      String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model DeviceUsageLog {
  id        String   @id @default(cuid())
  deviceId  String
  date      String
  userId    String
  createdAt DateTime @default(now())

  @@index([deviceId, date])
  @@index([date])
}

model TranslationRecord {
  id                 String   @id @default(cuid())
  userId             String?
  word               String
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  isCached           Boolean  @default(false)
  responseTime       Int?
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime @default(now())
  requestHash        String?

  @@index([requestHash])
  @@index([createdAt])
  @@index([word])
  @@index([userId])
}

model User {
  id                     String                   @id @default(cuid())
  username               String                   @unique
  password               String
  isAdmin                Boolean                  @default(false)
  isBanned               Boolean                  @default(false)
  banReason              String?
  banExpiresAt           DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  IgnoredWord            IgnoredWord[]
  ReviewGroup            ReviewGroup[]
  SecurityViolation      SecurityViolation[]
  SharedVocabulary       SharedVocabulary[]
  SharedVocabularyImport SharedVocabularyImport[]
  TranslateOnlyUsage     TranslateOnlyUsage[]
  UserPreference         UserPreference?
  Word                   Word[]
}

model UserPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  defaultShowPos        Boolean  @default(true)
  defaultShowExample    Boolean  @default(true)
  defaultShowPhonetic   Boolean  @default(true)
  dailyGoal             Int      @default(20)
  reviewReminderEnabled Boolean  @default(false)
  reviewReminderTime    String?
  theme                 String   @default("system")
  language              String   @default("zh-CN")
  danmakuEnabled        Boolean  @default(false)
  danmakuSpeed          Float    @default(1.0)
  danmakuOpacity        Float    @default(0.7)
  createdAt             DateTime @default(now())
  updatedAt             DateTime
  User                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Word {
  id                 String            @id @default(cuid())
  word               String
  phonetic           String?
  pos                String?
  translation        String?
  example            String?
  exampleTranslation String?
  correctCount       Int               @default(0)
  incorrectCount     Int               @default(0)
  totalAttempts      Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime
  userId             String
  sourceType         String            @default("USER")
  publicWordId       String?
  publicWord         PublicWord?       @relation(fields: [publicWordId], references: [id], onDelete: SetNull)
  ReviewGroupWord    ReviewGroupWord[]
  User               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([word, userId])
  @@index([userId, word])
  @@index([publicWordId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([totalAttempts])
}

model DonationConfig {
  id          String   @id @default("global")
  title       String   @default("Support EZTor")
  description String?
  imageUrl    String?
  linkUrl     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
