{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/llm-config/layout,_N_T_/llm-config/page,_N_T_/llm-config"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/llm-config/__PAGE__",
    "/llm-config",
    "/_index",
    "/_head"
  ]
}