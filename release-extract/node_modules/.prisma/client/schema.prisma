// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  password     String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  words        Word[]
  reviewGroups ReviewGroup[]
}

model Word {
  id                 String   @id @default(cuid())
  word               String // Removed @unique so different users can have the same word
  phonetic           String? // 音标，可选
  pos                String? // 词性，可选
  translation        String // 中文翻译
  example            String? // 英文例句
  exampleTranslation String? // 例句翻译
  correctCount       Int      @default(0) // 默写答对次数
  incorrectCount     Int      @default(0) // 默写答错次数
  createdAt          DateTime @default(now()) // 创建时间
  updatedAt          DateTime @updatedAt // 更新时间

  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewGroupWords ReviewGroupWord[]

  @@unique([word, userId]) // Ensures a specific user doesn't add the same word twice
}

// 用户创建的复习分组（最多3个，每个最多300词）
model ReviewGroup {
  id        String            @id @default(cuid())
  name      String // 分组名称
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  words     ReviewGroupWord[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([name, userId]) // 同一用户不能有同名分组
}

// 复习分组和单词的关联表 (多对多关系)
model ReviewGroupWord {
  id            String   @id @default(cuid())
  reviewGroupId String
  wordId        String
  addedAt       DateTime @default(now())

  reviewGroup ReviewGroup @relation(fields: [reviewGroupId], references: [id], onDelete: Cascade)
  word        Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([reviewGroupId, wordId]) // 一个单词在同一个分组中只能出现一次
}

// 全局公共词库，用于缓存 AI 解析结果和作为公共复习来源
model PublicWord {
  id                 String   @id @default(cuid())
  word               String   @unique // 公共词库中每个单词唯一
  phonetic           String?
  pos                String?
  translation        String
  example            String?
  exampleTranslation String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// 全局 API 配置（仅存一条记录）
model ApiConfig {
  id           String   @id @default("global") // 锁定 ID 为 "global" 确保只有一条
  apiKey       String
  baseUrl      String   @default("https://api.openai.com/v1/chat/completions")
  model        String   @default("gpt-4o-mini")
  systemPrompt String? // 自定义系统提示词（软编码）
  updatedAt    DateTime @updatedAt
}
