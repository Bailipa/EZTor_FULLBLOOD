# 生产环境示例（不要提交 .env 到仓库）

NODE_ENV=production
PORT=3000

# 站点域名（必须是 https://dogeggcode.cyou 这种完整 URL）
#NEXTAUTH_URL="https://dogeggcode.cyou"
NEXTAUTH_URL="localhost:3000"
#NEXT_PUBLIC_APP_URL="https://dogeggcode.cyou"
NEXT_PUBLIC_APP_URL="localhost:3000"

# NextAuth 密钥（请自行生成一个随机值）
NEXTAUTH_SECRET=""

# PostgreSQL 数据库
DATABASE_URL="postgresql://postgres:password@localhost:5432/eztor?schema=public"

# 允许的 CSRF 来源（用逗号分隔多个）
CSRF_ALLOWED_ORIGINS="https://dogeggcode.cyou"

# 火山方舟 DeepSeek 示例（不需要 /chat/completions 后缀）
LLM_API_URL="https://ark.cn-beijing.volces.com/api/v3"
LLM_MODEL="deepseek-v3-250324"
LLM_API_KEY=""

# TTS 代理（部署在 HuggingFace 或本地的 Python edgeTTS-openai-api）
# 本地默认: http://localhost:5050/v1/audio/speech
# HuggingFace 示例: https://username-space.hf.space/v1/audio/speech
TTS_PROXY_URL="http://localhost:5050/v1/audio/speech"
TTS_PROXY_API_KEY="sk"
