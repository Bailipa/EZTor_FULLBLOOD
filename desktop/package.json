{
  "name": "eztor-desktop",
  "version": "1.13.0",
  "description": "EZTor 桌面套壳应用（含全局弹幕悬浮窗）",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build": "electron-builder --mac --win --linux"
  },
  "build": {
    "appId": "com.eztor.app",
    "productName": "EZTor",
    "electronVersion": "37.2.0",
    "directories": {
      "output": "../public/downloads",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "tray-icon.png",
      "tray-icon@2x.png",
      "tray-icon-mac.png",
      "tray-icon-mac@2x.png",
      "icon-512.png",
      "tray-popup.html",
      "tray-popup-preload.js"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "EZTor-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "generic",
      "url": "https://eztor.dogeggcode.cyou/updates/"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "homepage": "https://eztor.dogeggcode.cyou",
  "author": "EZTor"
}